# Hostinger injects PORT. Only define it manually if hPanel explicitly asks.
NODE_ENV=production
STATIC_DIR=./public

# Required: copy the Supabase Session pooler string from Project > Connect.
# Prefer session mode (port 5432) for Hostinger's IPv4 network.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# If Hostinger reports a self-signed certificate chain, add the full PEM from
# Supabase > Database Settings > SSL Configuration as this environment value.
# Keep certificate verification enabled; do not use rejectUnauthorized=false.
# DATABASE_SSL_CA=

# Required: generate a new long random value and enter it in Hostinger's
# environment variable interface. Do not commit or upload a real value.
SESSION_SECRET=replace-with-a-long-random-production-secret

# Required only when the database does not already contain the admin user.
INITIAL_ADMIN_MOBILE=replace-with-your-admin-mobile
INITIAL_ADMIN_PIN=replace-with-a-strong-admin-pin
INITIAL_ADMIN_FULL_NAME=Administrator

# SUPABASE_URL and SUPABASE_ANON_KEY are not used by this server.
# GOLDAPI_KEY is also not used by the current source code.

# Optional operational settings
LOG_LEVEL=info
AUDIT_LOG_RETENTION_MONTHS=24
AUDIT_LOG_WARN_THRESHOLD=1000