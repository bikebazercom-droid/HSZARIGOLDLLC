modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:invoice-delete-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "audit-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pdf-branding"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pdf-browser-downloads"

[[workflows.workflow]]
name = "test:invoice-delete-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:invoice-delete-audit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "audit-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:all-audit-guards"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pdf-branding"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:pdf-branding"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pdf-browser-downloads"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:pdf-browser-downloads"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["chromium", "tesseract", "poppler"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22827
externalPort = 80
