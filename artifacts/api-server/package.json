{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:category-migration-test": "tsc -p tsconfig.category-migration-test.json --noEmit",
    "typecheck:category-statement-test": "tsc -p tsconfig.category-statement-test.json --noEmit",
    "test:invoice-delete-guard": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-invoice-delete-guard.ts",
    "test:invoice-category-rates": "tsx scripts/test-invoice-category-rates.ts",
    "test:invoice-delete-audit": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-invoice-delete-audit.ts",
    "test:bill-delete-role-guard": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-bill-delete-role-guard.ts",
    "test:invoice-create-audit": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-invoice-create-audit.ts",
    "test:pdf-branding": "tsx scripts/test-pdf-branding.ts",
    "test:suite-fixture-recovery": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-suite-fixture-recovery.ts",
    "test:pdf-browser-downloads": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock sh -c 'tsx scripts/test-pdf-fixture-recovery.ts && tsx scripts/run-pdf-browser-test.ts'",
    "test:prices-singleton": "tsx scripts/test-prices-singleton.ts",
    "test:category-migration": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-category-migration.ts",
    "test:category-statement-reconciliation": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-category-statement-reconciliation.ts",
    "test:bill-delete-audit": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-bill-delete-audit.ts",
    "test:bill-payment-status-audit": "flock --exclusive --wait 300 /tmp/gold-shop-suite-registry.lock tsx scripts/test-bill-payment-status-audit.ts",
    "test:all-audit-guards": "pnpm run test:suite-fixture-recovery && pnpm run test:invoice-delete-guard && pnpm run test:invoice-delete-audit && pnpm run test:invoice-create-audit && pnpm run test:bill-delete-role-guard && pnpm run test:bill-delete-audit && pnpm run test:bill-payment-status-audit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
